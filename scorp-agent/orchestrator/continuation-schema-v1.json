{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "scorp.orchestrator/continuation-v1",
  "type": "object",
  "definitions": {
    "request": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "protocol_version",
        "request_id",
        "task_id",
        "project_id",
        "registry_sequence",
        "continuation_generation",
        "question",
        "safety_class",
        "created_at",
        "expires_at"
      ],
      "properties": {
        "protocol_version": {"type": "string", "enum": ["scorp.orchestrator/continuation-request-v1"]},
        "request_id": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1},
        "project_id": {"type": "string", "minLength": 1},
        "registry_sequence": {"type": "integer", "minimum": 0},
        "continuation_generation": {"type": "integer", "minimum": 0},
        "question": {"type": "string", "minLength": 1},
        "safety_class": {"type": "string", "minLength": 1},
        "previous_action_id": {"type": ["string", "null"]},
        "previous_result_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "created_at": {"type": "string", "minLength": 1},
        "expires_at": {"type": "string", "minLength": 1}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "protocol_version",
        "decision_id",
        "request_id",
        "task_id",
        "expected_registry_sequence",
        "previous_continuation_generation",
        "mutation"
      ],
      "properties": {
        "protocol_version": {"type": "string", "enum": ["scorp.orchestrator/continuation-decision-v1"]},
        "decision_id": {"type": "string", "minLength": 1},
        "request_id": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1},
        "expected_registry_sequence": {"type": "integer", "minimum": 0},
        "previous_action_id": {"type": ["string", "null"]},
        "previous_result_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "previous_continuation_generation": {"type": "integer", "minimum": 0},
        "created_at": {"type": ["string", "null"]},
        "expires_at": {"type": ["string", "null"]},
        "mutation": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": {"type": "string", "enum": ["SET_NEXT_ACTION", "SET_TERMINAL", "CREATE_CHILD_TASKS", "SET_WAITING", "SET_BLOCKED"]},
            "next_action": {"type": ["object", "null"]},
            "state": {"type": ["string", "null"]},
            "reason": {"type": ["string", "null"]},
            "children": {"type": ["array", "null"]}
          }
        }
      }
    }
  }
}
