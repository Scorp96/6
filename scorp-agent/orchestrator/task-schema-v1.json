{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "scorp.orchestrator/task-v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "protocol_version",
    "task_id",
    "project_id",
    "priority",
    "state",
    "dependencies",
    "dependency_policy",
    "parallel_safety",
    "execution_adapter",
    "next_action",
    "attempts",
    "max_attempts",
    "created_at",
    "updated_at",
    "evidence_refs",
    "safety_class",
    "generation",
    "resource_scope"
  ],
  "properties": {
    "protocol_version": {"type": "string", "enum": ["scorp.orchestrator/task-v1"]},
    "task_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "priority": {"type": "integer"},
    "state": {"type": "string", "enum": ["STAGED", "READY", "RUNNING", "DONE", "FAILED", "WAITING", "BLOCKED"]},
    "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "dependency_policy": {"type": "string", "enum": ["all_done"]},
    "parallel_safety": {"type": "boolean"},
    "execution_adapter": {"type": "string", "enum": ["LOCAL_V4", "GPT_HOST"]},
    "next_action": {"type": ["object", "null"]},
    "continuation_request_id": {"type": ["string", "null"]},
    "checkpoint": {"type": ["object", "string", "null"]},
    "attempts": {"type": "integer", "minimum": 0},
    "max_attempts": {"type": "integer", "minimum": 1},
    "next_eligible_at": {"type": ["string", "null"]},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1},
    "last_result": {"type": ["object", "null"]},
    "evidence_refs": {"type": "array"},
    "safety_class": {"type": "string", "minLength": 1},
    "authorization_requirement": {"type": ["string", "null"]},
    "waiting_reason": {"type": ["string", "null"]},
    "blocker": {"type": ["object", "string", "null"]},
    "lease": {"type": ["object", "null"]},
    "generation": {"type": "integer", "minimum": 0},
    "resource_scope": {"type": "array", "items": {"type": "string"}}
  }
}
